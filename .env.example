# PocketBase (server URL is also set via NEXT_PUBLIC_POCKETBASE_URL in .env.local)
NEXT_PUBLIC_POCKETBASE_URL=https://your-pocketbase.example.com

# PocketBase superuser — used by /api/segments/cleanup-locks cron to bypass
# segments.updateRule. Set on Vercel + locally. (Same superuser used by the
# migration/pocketbase import scripts.)
POCKETBASE_ADMIN_EMAIL=admin@your-domain.local
POCKETBASE_ADMIN_PASSWORD=change-me

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENROUTER_API_KEY=your-openrouter-key
LLM_PROVIDER=openrouter

# Vercel Cron auth (required by /api/segments/cleanup-locks).
# Set a random string (>=16 chars) on the Vercel project; Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` on every cron invocation.
CRON_SECRET=your-random-cron-secret

# Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_DSN.ingest.us.sentry.io/PROJECT_ID
SENTRY_AUTH_TOKEN=YOUR_AUTH_TOKEN
SENTRY_ORG=YOUR_ORG_SLUG
SENTRY_PROJECT=YOUR_PROJECT_SLUG
